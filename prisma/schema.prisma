datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Table {
  id          String          @id @default(uuid())
  number      Int             @unique
  capacity    Int             @default(4)
  section     String          @default("Main Dining")
  status      String          @default("VACANT") // VACANT, OCCUPIED, BILL_REQUESTED, NEEDS_CLEANING
  qrCodeUrl   String?
  orders      Order[]
  requests    WaiterRequest[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  sortOrder   Int        @default(0)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Float
  image       String?
  isVeg       Boolean     @default(true)
  isAvailable Boolean     @default(true)
  spicyLevel  Int         @default(0) // 0: None, 1: Mild, 2: Medium, 3: Hot
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            String        @id @default(uuid())
  tableId       String
  table         Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status        String        @default("PENDING") // PENDING, PREPARING, READY, SERVED, CANCELLED
  paymentStatus String        @default("UNPAID") // UNPAID, PAID, REFUNDED
  paymentMethod String?       // CASH, CARD, UPI, STRIPE
  totalAmount   Float
  notes         String?
  items         OrderItem[]
  feedback      Feedback?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float
  notes      String?
}

model WaiterRequest {
  id         String   @id @default(uuid())
  tableId    String
  table      Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  type       String   // WATER, CUTLERY, HELP, BILL
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
